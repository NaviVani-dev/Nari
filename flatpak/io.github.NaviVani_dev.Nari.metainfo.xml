<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.NaviVani_dev.Nari</id>
  <name>Nari</name>
  <summary>Beautiful feature-rich music player</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.navivani_dev">
    <name>NaviVani</name>
  </developer>

  <description>
    <p>A beautiful music player with a retro console experience in mind, made for handheld consoles, phones and desktops alike.</p>
    <ul>
      <li>Plays your local music library</li>
      <li>Synced lyrics, fetched online</li>
      <li>Full gamepad support</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.NaviVani_dev.Nari.desktop</launchable>
  <url type="homepage">https://github.com/NaviVani-dev/Nari</url>
  <url type="bugtracker">https://github.com/NaviVani-dev/Nari/issues</url>
  <url type="vcs-browser">https://github.com/NaviVani-dev/Nari</url>

