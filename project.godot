; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Nari"
config/description="Beautiful feature-rich music player"
config/version="1.1.0"
run/main_scene="uid://bx8kvd8ogfd47"
run/print_header=false
config/use_custom_user_dir=true
config/custom_user_dir_name="Nari"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
run/low_processor_mode=true
boot_splash/bg_color=Color(1, 1, 1, 1)
boot_splash/show_image=false
boot_splash/use_filter=false
config/icon="uid://bmthg0hcklngh"
run/low_processor_mode.android=false

[audio]

driver/driver="Dummy"

[autoload]

DevTools="*res://systems/debug/DevTools.tscn"
SettingsManager="*res://systems/settings/settings_manager.gd"
MediaPlayer="*uid://dbdkhh3yb1klu"
Soundboard="*res://globals/Soundboard.gd"
ThemeEngine="*uid://cokdt6oubaqml"
Themes="*res://globals/Themes.gd"
Main="*res://globals/Main.gd"
InputGlyphs="*res://globals/InputGlyphs.gd"
Plugins="*res://globals/Plugins.gd"
Marketplace="*res://globals/Marketplace.gd"
AppUpdates="*res://globals/AppUpdates.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[editor]

run/main_run_args="--no-header"

[editor_plugins]

enabled=PackedStringArray("res://addons/AynThor/plugin.cfg", "res://addons/MusicService/plugin.cfg", "res://addons/SmoothScroll/plugin.cfg")

[gui]

theme/custom="res://assets/themes/ui.tres"
theme/custom_font="uid://mf1c4rg1h7is"

[importer_defaults]

svg={
"base_scale": 6.0,
"color_map": {},
"compress": true,
"saturation": 1.0
}

